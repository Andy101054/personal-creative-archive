---
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {allProjects,categories,statuses} from '../lib/archive';
const projects=await allProjects();const tags=[...new Set(projects.flatMap(p=>p.data.tags))].sort();const years=[...new Set(projects.flatMap(p=>p.data.date?[p.data.date.slice(0,4)]:[]))].sort().reverse();
---
<Layout title="档案馆"><section class="page-intro"><h1>档案馆</h1></section>
<form id="filters" class="filters" role="search" aria-label="筛选档案"><label class="search">搜索作品<input name="q" type="search" placeholder="搜索名称、标签或简介…"/></label><div class="filter-row">
<label>类别<select name="category"><option value="">全部类别</option>{Object.entries(categories).map(([v,l])=><option value={v}>{l}</option>)}</select></label>
<label>年份<select name="year"><option value="">全部年份</option>{years.map(y=><option>{y}</option>)}<option value="unknown">日期待补充</option></select></label>
<label>状态<select name="status"><option value="">全部状态</option>{Object.entries(statuses).map(([v,l])=><option value={v}>{l}</option>)}<option value="unknown">状态待确认</option></select></label>
<label>标签<select name="tag"><option value="">全部标签</option>{tags.map(t=><option>{t}</option>)}</select></label>
<label>排序<select name="sort"><option value="newest">创作日期：新 → 旧</option><option value="oldest">创作日期：旧 → 新</option><option value="title">作品名称</option></select></label><button type="reset" class="reset">重置筛选 ↺</button></div></form>
<div class="results-bar"><p id="count" role="status" aria-live="polite">{projects.length} 件作品</p></div><noscript><p>JavaScript 已关闭：以下展示完整档案，筛选需要 JavaScript。</p></noscript><div class="grid" id="results">{projects.map((p,i)=><Card project={p} index={i}/>)}</div><p id="no-results" class="empty-panel" hidden>没有匹配的作品。</p>
<script>
import {matches,compareProjects} from '../lib/filter.mjs';
const form=document.querySelector<HTMLFormElement>('#filters')!;const grid=document.querySelector('#results')!;const cards=[...grid.querySelectorAll<HTMLElement>('[data-project]')];
const params=new URLSearchParams(location.search);for(const input of form.elements){if(input instanceof HTMLInputElement||input instanceof HTMLSelectElement){const value=params.get(input.name);if(value!==null)input.value=value;}}
function update(){const filters=Object.fromEntries(new FormData(form).entries()) as Record<string,string>;let count=0;cards.sort((a,b)=>compareProjects(a.dataset,b.dataset,filters.sort)).forEach(card=>{card.hidden=!matches(card.dataset,filters);if(!card.hidden)count++;grid.append(card)});document.querySelector('#count')!.textContent=`${count} / ${cards.length} 件作品`;document.querySelector<HTMLElement>('#no-results')!.hidden=count!==0;const q=new URLSearchParams(Object.entries(filters).filter(([,v])=>v!==''));history.replaceState(null,'',`${location.pathname}${q.size?'?'+q:''}`);}
form.addEventListener('input',update);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(update,0));update();
</script></Layout>
