---
import {render} from 'astro:content';import Layout from '../../layouts/Layout.astro';import {allProjects,href,categories,statuses,dateLabel} from '../../lib/archive';
export async function getStaticPaths(){return (await allProjects()).map(project=>({params:{slug:project.data.slug},props:{project}}));}
const {project}=Astro.props;const d=project.data;const {Content}=await render(project);
---
<Layout title={d.title} description={d.description}><a class="back" href={href('archive/')}>← 返回档案馆</a><section class="project-heading"><p class="eyebrow">{categories[d.category]} / CREATIVE RECORD</p><h1>{d.title}</h1><p class="lead">{d.description}</p><div class="tags">{d.tags.map(t=><a href={`${href('archive/')}?tag=${encodeURIComponent(t)}`}>#{t}</a>)}</div></section>
{d.placeholder&&<p class="notice">占位档案 · 介绍仅基于现有信息，图片、日期与详细记录待补充。</p>}
{d.cover&&<figure class="artwork-view"><a href={href(d.fullImage || d.cover)} data-zoom data-alt={d.coverAlt} aria-label={`放大查看 ${d.title}`}><img class="project-cover" src={href(d.cover)} alt={d.coverAlt} width={d.coverWidth || 1440} height={d.coverHeight || 960} decoding="async"/></a>{d.fullImage&&<figcaption><span>点击画面放大 · 保留完整比例</span><a href={href(d.fullImage)} target="_blank" rel="noopener noreferrer">查看高清图片 ↗</a></figcaption>}</figure>}
<div class:list={["project-layout", {"without-facts": !d.date&&!d.status&&!d.updated&&!d.version&&!d.repositoryUrl&&!d.demoUrl}]}><aside class="facts"><dl>{d.date&&<><dt>创作时间</dt><dd>{dateLabel(d.date)}</dd></>}{d.status&&<><dt>完成状态</dt><dd>{statuses[d.status]}</dd></>}{d.updated&&<><dt>最后更新</dt><dd>{d.updated}</dd></>}{d.version&&<><dt>版本</dt><dd>{d.version}</dd></>}</dl>{d.repositoryUrl&&<a class="external" href={d.repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub 仓库 ↗</a>}{d.demoUrl&&<a class="external" href={d.demoUrl} target="_blank" rel="noopener noreferrer">试玩 / 查看作品 ↗</a>}</aside><div class="prose"><Content/>
{d.gallery.length>0&&<section><h2>作品画廊</h2><div class="gallery">{d.gallery.map(g=><figure><a href={href(g.src)} data-zoom data-alt={g.alt}><img src={href(g.src)} alt={g.alt} loading="lazy" width="1000" height="700"/></a>{g.caption&&<figcaption>{g.caption}</figcaption>}</figure>)}</div></section>}
{d.changelog.length>0&&<section><h2>更新记录</h2><ul>{[...d.changelog].sort((a,b)=>b.date.localeCompare(a.date)).map(c=><li><time datetime={c.date}>{c.date}</time> — {c.text}</li>)}</ul></section>}</div></div>
<dialog id="lightbox" aria-label="图片预览"><div class="lightbox-toolbar"><a id="full-image-link" target="_blank" rel="noopener noreferrer">查看高清图片 ↗</a><button type="button" autofocus aria-label="关闭图片预览">关闭 ×</button></div><img alt=""/></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#lightbox')!;let trigger:HTMLAnchorElement|null=null;
function close(){dialog.close();trigger?.focus();}
document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();trigger=a;const img=dialog.querySelector('img')!;img.src=a.href;img.alt=a.dataset.alt||'';dialog.querySelector<HTMLAnchorElement>('#full-image-link')!.href=a.href;dialog.showModal()}));
dialog.querySelector('button')!.addEventListener('click',close);dialog.addEventListener('click',e=>{if(e.target===dialog)close()});dialog.addEventListener('close',()=>trigger?.focus());
</script></Layout>
