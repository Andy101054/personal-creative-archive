---
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {allProjects,href} from '../lib/archive';import {profile} from '../config';
const projects=await allProjects();const featured=projects.filter(p=>p.data.featured);const recent=projects.filter(p=>p.data.updated).sort((a,b)=>(b.data.updated||'').localeCompare(a.data.updated||'')).slice(0,3);
---
<Layout>
<section class="hero"><div><h1>作品档案</h1><p class="hero-description">{profile.intro}</p><a class="button" href={href('archive/')}>浏览全部作品 <span>↗</span></a></div></section>
<section><div class="section-head"><h2>精选作品</h2><a href={href('archive/')}>全部作品 ↗</a></div><div class="grid">{featured.map((p,i)=><Card project={p} index={i}/>)}</div></section>
{recent.length>0&&<section class="recent"><div class="section-head"><h2>最近更新</h2></div><div class="grid">{recent.map((p,i)=><Card project={p} index={i}/>)}</div></section>}
</Layout>
